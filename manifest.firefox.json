{
  "manifest_version": 3,
  "name": "Mousewho",
  "description": "Blazing-fast keyboard-only Firefox control for Vim-style browsing.",
  "version": "0.1.0",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/hints.js", "src/dom.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "next-tab": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Alt+Shift+L" },
      "description": "Activate the next tab"
    },
    "previous-tab": {
      "suggested_key": { "default": "Alt+Shift+H", "mac": "Alt+Shift+H" },
      "description": "Activate the previous tab"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mousewho@example.com",
      "strict_min_version": "109.0"
    }
  }
}
